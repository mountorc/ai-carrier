{
  "routes": [
    {
      "method": "GET",
      "path": "/role/list",
      "handler": "GetRoleListHandler",
      "description": "获取角色列表"
    },
    {
      "method": "GET",
      "path": "/role/get",
      "handler": "GetRoleHandler",
      "description": "获取单个角色详情"
    },
    {
      "method": "POST",
      "path": "/role/create",
      "handler": "CreateRoleHandler",
      "description": "创建新角色"
    },
    {
      "method": "PUT",
      "path": "/role/update",
      "handler": "UpdateRoleHandler",
      "description": "更新角色信息"
    },
    {
      "method": "DELETE",
      "path": "/role/delete",
      "handler": "DeleteRoleHandler",
      "description": "删除角色"
    },
    {
      "method": "GET",
      "path": "/role/get-by-name",
      "handler": "GetRoleByNameHandler",
      "description": "根据名称获取角色"
    }
  ]
}
