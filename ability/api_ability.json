{
  "description": "能力中心 API 配置文件 - 提供能力注册、能力发现、心跳管理、代理 ability 管理等能力中心相关接口",
  "routes": [
    {
      "method": "POST",
      "path": "/ability/worker/register",
      "handler": "workerRegisterHandler"
    },
    {
      "method": "POST",
      "path": "/ability/proxy-ability/add",
      "handler": "addProxyAbilityHandler"
    },
    {
      "method": "POST",
      "path": "/ability/heartbeat",
      "handler": "heartbeatHandler"
    },
    {
      "method": "POST",
      "path": "/ability/discover",
      "handler": "discoverHandler"
    },
    {
      "method": "GET",
      "path": "/ability/list",
      "handler": "listHandler"
    },
    {
      "method": "POST",
      "path": "/ability/unregister",
      "handler": "unregisterHandler"
    },
    {
      "method": "GET",
      "path": "/ability/worker/get",
      "handler": "getWorkerHandler"
    },
    {
      "method": "GET",
      "path": "/ability/worker/list",
      "handler": "getWorkListHandler"
    },
    {
      "method": "GET",
      "path": "/ability/proxy-ability/get",
      "handler": "getProxyAbilityHandler"
    },
    {
      "method": "POST",
      "path": "/ability/proxy-ability/update",
      "handler": "updateProxyAbilityHandler"
    },
    {
      "method": "POST",
      "path": "/ability/proxy-ability/toggle",
      "handler": "toggleProxyAbilityEnabledHandler"
    },
    {
      "method": "GET",
      "path": "/ability/proxy-ability/list",
      "handler": "getProxyAbilityListHandler"
    },
    {
      "method": "POST",
      "path": "/ability/worker/execute",
      "handler": "executeWorkerHandler"
    },
    {
      "method": "GET",
      "path": "/ability/get",
      "handler": "getAbilityHandler"
    },
    {
      "method": "GET",
      "path": "/ability/vector-search",
      "handler": "vectorSearchHandler"
    },
    {
      "method": "GET",
      "path": "/ability/text-search",
      "handler": "textSearchHandler"
    },
    {
      "method": "GET",
      "path": "/ability/project/list",
      "handler": "listProjectsHandler"
    },
    {
      "method": "GET",
      "path": "/ability/project/get",
      "handler": "getProjectHandler"
    },
    {
      "method": "GET",
      "path": "/ability/agent/list",
      "handler": "GetAgentListDBHandler"
    },
    {
      "method": "POST",
      "path": "/ability/agent/register",
      "handler": "AgentRegisterHandler"
    },
    {
      "method": "GET",
      "path": "/ability/skill/list",
      "handler": "getSkillListHandler"
    },
    {
      "method": "GET",
      "path": "/ability/skill/get",
      "handler": "getSkillHandler"
    },
    {
      "method": "POST",
      "path": "/ability/sql/execute/:uuid",
      "handler": "executeAbilitySQLByUUID"
    }
  ]
}
